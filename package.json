{
  "name": "pca-cinemas",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n WEB,API -c red,gray \"npm run dev --workspace=pca-web\" \"npm run dev --workspace=pca-api\"",
    "build": "npm run build --workspace=pca-web",
    "start": "npm run start --workspace=pca-api",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.0"
  }
}
